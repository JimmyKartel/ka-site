{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/gallery.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}